  { id: "d1-numazu-atami", from: "numazu", to: "atami", day: 1, jr18: true, fareYen: null, title: "沼津 → 熱海" },
  { id: "d1-atami-yokohama", from: "atami", to: "yokohama", day: 1, jr18: true, fareYen: null, title: "熱海 → 横浜" },
