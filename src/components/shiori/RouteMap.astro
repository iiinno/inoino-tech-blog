    ],
  },
  { id: "d3-atami-shizuoka", from: "atami", to: "shizuoka", day: 3, jr18: true, fareYen: null, title: "熱海 → 静岡" },
  { id: "d3-shizuoka-yaizu", from: "shizuoka", to: "yaizu", day: 3, jr18: true, fareYen: null, title: "静岡 → 焼津" },
];

interface Props {
  stations?: Station[];
  segments?: Segment[];
}

const { stations = STATIONS, segments = SEGMENTS } = Astro.props;

const VB_W = 1000;
const VB_H = 740;
const PAD = 56;

type XY = { x: number; y: number };

const stationById = new Map(stations.map(s => [s.id, s]));

const lats = stations.map(s => s.lat);
const lngs = stations.map(s => s.lng);
const latMin = Math.min(...lats);
const latMax = Math.max(...lats);
const lngMin = Math.min(...lngs);
const lngMax = Math.max(...lngs);
const cosLat = Math.cos((((latMin + latMax) / 2) * Math.PI) / 180);
const spanX = Math.max((lngMax - lngMin) * cosLat, 1e-6);
const spanY = Math.max(latMax - latMin, 1e-6);
const innerW = VB_W - PAD * 2;
const innerH = VB_H - PAD * 2;
const scale = Math.min(innerW / spanX, innerH / spanY);
const ox = PAD + (innerW - spanX * scale) / 2;
const oy = PAD + (innerH - spanY * scale) / 2;

function project(lat: number, lng: number): XY {
  return {
    x: ox + (lng - lngMin) * cosLat * scale,
    y: oy + (latMax - lat) * scale,
  };
}

function offsetPoly(points: XY[], dist: number): XY[] {
  if (dist === 0 || points.length < 2) return points;
  // 直線区間は中間点を補間してからずらす（端で曲がるように）
  let pts = points;
  if (pts.length === 2) {
    const [a, b] = pts;
    pts = [0, 0.25, 0.5, 0.75, 1].map(t => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }));
  }
  // 両端はオフセット 0 に収束させて駅ドットに接続し、中間だけ平行にずらす
  const cum = [0];
  for (let i = 1; i < pts.length; i++) cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
  const total = cum[cum.length - 1] || 1;
  const edge = 0.22;
  const ramp = (t: number) => (t < edge ? t / edge : t > 1 - edge ? (1 - t) / edge : 1);
  return pts.map((p, i) => {
    const prev = pts[Math.max(0, i - 1)];
    const next = pts[Math.min(pts.length - 1, i + 1)];
    const dx = next.x - prev.x;
    const dy = next.y - prev.y;
    const len = Math.hypot(dx, dy) || 1;
    const d = dist * ramp(cum[i] / total);
    return { x: p.x + (-dy / len) * d, y: p.y + (dx / len) * d };
  });
}

function lngLatPolyToD(poly: [number, number][], close = false): string {
  if (poly.length === 0) return "";
  const parts = poly.map(([lng, lat], i) => {
    const { x, y } = project(lat, lng);
    return `${i === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`;
  });
  if (close) parts.push("Z");
  return parts.join(" ");
}

function midPoint(pts: XY[]): XY {
  if (pts.length === 0) return { x: 0, y: 0 };
  if (pts.length === 1) return pts[0];
  const i = Math.floor(pts.length / 2);
  if (pts.length % 2 === 1) return pts[i];
  return {
    x: (pts[i - 1].x + pts[i].x) / 2,
    y: (pts[i - 1].y + pts[i].y) / 2,
  };
}

function badgeLabel(fareYen: number | null, jr18: boolean): string | null {
  if (fareYen !== null) return `¥${fareYen}`;
  if (jr18) return "18切符";
  return null;
}

function estimateBadgeWidth(label: string): number {
  let w = 0;
  for (const ch of label) {
    w += /[¥0-9A-Za-z]/.test(ch) ? 7.2 : 11;
  }
  return Math.max(w + 12, 28);
}

interface DrawnSeg {
  id: string;
  d: string;
  day: 1 | 2 | 3;
  jr18: boolean;
  title: string;
  fareYen: number | null;
  fareNote: string;
  mx: number;
  my: number;
  badge: string | null;
  badgeW: number;
}

const drawn: DrawnSeg[] = segments.flatMap(seg => {
  const from = stationById.get(seg.from);
  const to = stationById.get(seg.to);
  if (!from || !to) return [];
  const raw: XY[] = [
    project(from.lat, from.lng),
    ...(seg.via ?? []).map(v => project(v.lat, v.lng)),
    project(to.lat, to.lng),
  ];
  const pts = offsetPoly(raw, (seg.day - 2) * 9);
  const d = pts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(" ");
  const mid = midPoint(pts);
  const badge = badgeLabel(seg.fareYen, seg.jr18);
  return [
    {
      id: seg.id,
      d,
      day: seg.day,
      jr18: seg.jr18,
      title: seg.title,
      fareYen: seg.fareYen,
      fareNote: seg.fareNote ?? "",
      mx: mid.x,
      my: mid.y,
      badge,
      badgeW: badge ? estimateBadgeWidth(badge) : 0,
    },
  ];
});

const plottedStations = stations.map(s => ({
  ...s,
  ...project(s.lat, s.lng),
}));

const coastlinePaths = COASTLINE.map(poly => lngLatPolyToD(poly)).filter(Boolean);
const borderPaths = PREF_BORDERS.map(poly => lngLatPolyToD(poly)).filter(Boolean);

const GRID_STEP = 0.5;
const gridPad = 0.4;
const latGridStart = Math.floor((latMin - gridPad) / GRID_STEP) * GRID_STEP;
const latGridEnd = Math.ceil((latMax + gridPad) / GRID_STEP) * GRID_STEP;
const lngGridStart = Math.floor((lngMin - gridPad) / GRID_STEP) * GRID_STEP;
const lngGridEnd = Math.ceil((lngMax + gridPad) / GRID_STEP) * GRID_STEP;
const gridMeridians: string[] = [];
const gridParallels: string[] = [];
for (let lng = lngGridStart; lng <= lngGridEnd + 1e-9; lng += GRID_STEP) {
  const a = project(latGridStart, lng);
  const b = project(latGridEnd, lng);
  gridMeridians.push(`M${a.x.toFixed(1)} ${a.y.toFixed(1)}L${b.x.toFixed(1)} ${b.y.toFixed(1)}`);
}
for (let lat = latGridStart; lat <= latGridEnd + 1e-9; lat += GRID_STEP) {
  const a = project(lat, lngGridStart);
  const b = project(lat, lngGridEnd);
  gridParallels.push(`M${a.x.toFixed(1)} ${a.y.toFixed(1)}L${b.x.toFixed(1)} ${b.y.toFixed(1)}`);
}

const SEA_LABELS: { label: string; at: [number, number] }[] = [
  { label: "駿河湾", at: [138.58, 34.82] },
  { label: "相模湾", at: [139.35, 35.08] },
  { label: "東京湾", at: [139.82, 35.5] },
];

const landPaths = LAND.map(poly => poly.map(ring => lngLatPolyToD(ring, true)).join(" ")).filter(Boolean);

const seaLabels = SEA_LABELS.map(sea => {
  const pt = project(sea.at[1], sea.at[0]);
  return { label: sea.label, x: pt.x, y: pt.y };
});

const uid = `rm-${Math.random().toString(36).slice(2, 10)}`;

// 下地データの範囲（gen-underlay.mjs の BBOX と一致させる）。パン/ズームはこの内側にクランプする
const DATA_BOUNDS = { minLng: 137.8, maxLng: 140.8, minLat: 34.3, maxLat: 36.7 };
const dbX0 = project(0, DATA_BOUNDS.minLng).x;
const dbX1 = project(0, DATA_BOUNDS.maxLng).x;
const dbY0 = project(DATA_BOUNDS.maxLat, 0).y;
const dbY1 = project(DATA_BOUNDS.minLat, 0).y;
const boundsAttr = `${dbX0.toFixed(1)} ${dbY0.toFixed(1)} ${dbX1.toFixed(1)} ${dbY1.toFixed(1)}`;
---

<figure class="route-map" data-route-map={uid} data-bounds={boundsAttr} aria-label="旅程の路線図">
  <div class="route-map__bar">
    <ul class="route-map__legend">
      <li><span class="swatch swatch-d1" aria-hidden="true"></span>1日目 8/25</li>
      <li><span class="swatch swatch-d2" aria-hidden="true"></span>2日目 8/26</li>
      <li><span class="swatch swatch-d3" aria-hidden="true"></span>3日目 8/27</li>
      <li><span class="swatch swatch-jr" aria-hidden="true"></span>18切符（JR）</li>
    </ul>
    <button type="button" class="route-map__reset" data-reset>リセット</button>
  </div>

  <div class="route-map__viewport">
    <svg
      class="route-map__svg"
      viewBox={`0 0 ${VB_W} ${VB_H}`}
      style="--zk: 1"
      role="img"
      aria-label="駅と区間の路線図。線を選ぶと運賃が出る"
    >
      <defs>
        <filter id={`${uid}-jr-glow`} x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="2.4" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <g class="underlay" aria-hidden="true">
        {
          landPaths.map(d => (
            <path class="land__fill" d={d} fill-rule="evenodd" stroke="none" />
          ))
        }
        <g class="graticule">
          {gridMeridians.map(d => <path class="graticule__line" d={d} fill="none" />)}
          {gridParallels.map(d => <path class="graticule__line" d={d} fill="none" />)}
        </g>
        {
          coastlinePaths.map(d => (
            <path class="underlay__coast" d={d} fill="none" />
          ))
        }
        {
          borderPaths.map(d => (
            <path class="underlay__border" d={d} fill="none" />
          ))
        }
        {
          seaLabels.map(sea => (
            <text class="sea__label" x={sea.x} y={sea.y}>
              {sea.label}
            </text>
          ))
        }
      </g>

      <g class="routes">
        {
          drawn.map(seg => (
            <g
              class:list={["seg", `seg-d${seg.day}`, seg.jr18 && "is-jr"]}
              data-id={seg.id}
              data-title={seg.title}
              data-jr18={seg.jr18 ? "1" : "0"}
              data-fare={seg.fareYen === null ? "" : String(seg.fareYen)}
              data-note={seg.fareNote}
            >
              {seg.jr18 && (
                <>
                  <path class="seg__glow-outer" d={seg.d} fill="none" filter={`url(#${uid}-jr-glow)`} />
                  <path class="seg__glow-inner" d={seg.d} fill="none" />
                </>
              )}
              <path class="seg__casing" d={seg.d} fill="none" />
              <path class="seg__line" d={seg.d} fill="none" />
              <path class="seg__hit" d={seg.d} fill="none" />
              {seg.badge && (
                <g class="seg__badge" transform={`translate(${seg.mx.toFixed(1)} ${seg.my.toFixed(1)})`}>
                  <rect
                    class="seg__badge-bg"
                    style={`--bw: ${seg.badgeW}`}
                    x={(-seg.badgeW / 2).toFixed(1)}
                    y="-9"
                    width={seg.badgeW.toFixed(1)}
                    height="18"
                    rx="5"
                    ry="5"
                  />
                  <text class="seg__badge-text" text-anchor="middle" dominant-baseline="central">
                    {seg.badge}
                  </text>
                </g>
              )}
            </g>
          ))
        }
      </g>

      <g class="stations">
        {
          plottedStations.map(s => (
            <g class:list={["sta", s.major && "is-major"]} transform={`translate(${s.x} ${s.y})`}>
              <circle class="sta__ring" r={s.major ? 7.2 : 5.2} />
              <circle class="sta__core" r={s.major ? 3.4 : 2.4} />
              <text
                class:list={["sta__label", s.major && "is-major"]}
                x={s.labelDx ?? 10}
                y={s.labelDy ?? -10}
                text-anchor={s.labelAnchor ?? "start"}
              >
                {s.name}
              </text>
            </g>
          ))
        }
      </g>
    </svg>
  </div>

  <figcaption class="route-map__info" data-info>
    <p class="route-map__hint">線をタップ／ホバーすると運賃が出る。ピンチまたはホイールで拡大、ドラッグで移動。</p>
    <p class="route-map__detail" data-detail hidden></p>
  </figcaption>
</figure>

<script>
  type Root = HTMLElement;

  function fareText(fare: string, jr18: boolean, note: string): string {
    const bits: string[] = [];
    if (fare) bits.push(`${fare} 円`);
    else if (jr18) bits.push("—（青春18切符）");
    else bits.push("—");
    if (note) bits.push(note);
    return bits.join(" · ");
  }

  function init(root: Root) {
    const svg = root.querySelector("svg");
    const detail = root.querySelector<HTMLElement>("[data-detail]");
    const hint = root.querySelector<HTMLElement>(".route-map__hint");
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-reset]");
    if (!svg || !detail || !hint) return;

    const base = { x: 0, y: 0, w: 1000, h: 740 };
    const vb = { ...base };
    const minW = 220;
    const [bx0, by0, bx1, by1] = (root.getAttribute("data-bounds") ?? "0 0 1000 740").split(" ").map(Number);
    // データ範囲をはみ出さない上限（ズームアウトしすぎ防止）
    const maxW = Math.min(1400, bx1 - bx0, ((by1 - by0) * base.w) / base.h);
    const zoomDetailW = 620;

    const apply = () => {
      // パン範囲をデータ範囲内にクランプ（データ幅よりビューが広い場合は中央寄せ）
      vb.x = vb.w >= bx1 - bx0 ? (bx0 + bx1 - vb.w) / 2 : Math.min(Math.max(vb.x, bx0), bx1 - vb.w);
      vb.y = vb.h >= by1 - by0 ? (by0 + by1 - vb.h) / 2 : Math.min(Math.max(vb.y, by0), by1 - vb.h);
      svg.setAttribute("viewBox", `${vb.x} ${vb.y} ${vb.w} ${vb.h}`);
      svg.style.setProperty("--zk", String(vb.w / 1000));
      svg.classList.toggle("is-zoomed", vb.w < zoomDetailW);
    };

    const clientToVb = (cx: number, cy: number) => {
      const r = svg.getBoundingClientRect();
      return {
        x: vb.x + ((cx - r.left) / r.width) * vb.w,
        y: vb.y + ((cy - r.top) / r.height) * vb.h,
      };
    };

    const zoomAt = (cx: number, cy: number, factor: number) => {
      const p = clientToVb(cx, cy);
      const nw = Math.min(maxW, Math.max(minW, vb.w * factor));
      const nh = nw * (base.h / base.w);
      const k = nw / vb.w;
      vb.x = p.x - (p.x - vb.x) * k;
      vb.y = p.y - (p.y - vb.y) * k;
      vb.w = nw;
      vb.h = nh;
      apply();
    };

    const selectSeg = (g: SVGGElement | null) => {
      root.querySelectorAll(".seg.is-active").forEach(el => el.classList.remove("is-active"));
      if (!g) {
        detail.hidden = true;
        hint.hidden = false;
        return;
      }
      g.classList.add("is-active");
      const title = g.dataset.title ?? "";
      const jr18 = g.dataset.jr18 === "1";
      const fare = g.dataset.fare ?? "";
      const note = g.dataset.note ?? "";
      detail.hidden = false;
      hint.hidden = true;
      detail.textContent = `${title}　運賃 ${fareText(fare, jr18, note)}　18切符: ${jr18 ? "対象" : "対象外"}`;
    };

    svg.addEventListener(
      "wheel",
      (e: WheelEvent) => {
        e.preventDefault();
        const factor = e.deltaY > 0 ? 1.12 : 1 / 1.12;
        zoomAt(e.clientX, e.clientY, factor);
      },
      { passive: false },
    );

    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    let pointerId = -1;
    let pinchDist = 0;

    const onMove = (e: PointerEvent) => {
      if (!dragging || e.pointerId !== pointerId) return;
      const dx = e.clientX - lastX;
      const dy = e.clientY - lastY;
      const r = svg.getBoundingClientRect();
      vb.x -= (dx / r.width) * vb.w;
      vb.y -= (dy / r.height) * vb.h;
      lastX = e.clientX;
      lastY = e.clientY;
      apply();
    };

    const onUp = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      dragging = false;
      pointerId = -1;
      svg.releasePointerCapture(e.pointerId);
      window.removeEventListener("pointermove", onMove);
      window.removeEventListener("pointerup", onUp);
    };

    svg.addEventListener("pointerdown", (e: PointerEvent) => {
      if (e.button !== 0) return;
      const hit = (e.target as Element).closest<SVGGElement>(".seg");
      if (hit) selectSeg(hit);
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      pointerId = e.pointerId;
      svg.setPointerCapture(e.pointerId);
      window.addEventListener("pointermove", onMove);
      window.addEventListener("pointerup", onUp);
    });

    const touchDist = (t: TouchList) => {
      const a = t.item(0);
      const b = t.item(1);
      if (!a || !b) return 0;
      return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
    };
    const touchMid = (t: TouchList) => {
      const a = t.item(0);
      const b = t.item(1);
      if (!a || !b) return { x: 0, y: 0 };
      return { x: (a.clientX + b.clientX) / 2, y: (a.clientY + b.clientY) / 2 };
    };

    svg.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        if (e.touches.length === 2) {
          pinchDist = touchDist(e.touches);
        }
      },
      { passive: true },
    );

    svg.addEventListener(
      "touchmove",
      (e: TouchEvent) => {
        if (e.touches.length === 2 && pinchDist > 0) {
          e.preventDefault();
          const m = touchMid(e.touches);
          const d = touchDist(e.touches);
          zoomAt(m.x, m.y, pinchDist / d);
          pinchDist = d;
        }
      },
      { passive: false },
    );

    svg.addEventListener("touchend", () => {
      pinchDist = 0;
    });

    root.querySelectorAll<SVGGElement>(".seg").forEach(g => {
      g.addEventListener("pointerenter", () => {
        if (window.matchMedia("(hover: hover)").matches) selectSeg(g);
      });
    });

    resetBtn?.addEventListener("click", () => {
      Object.assign(vb, base);
      apply();
      selectSeg(null);
    });

    apply();
  }

  document.querySelectorAll<Root>("[data-route-map]").forEach(init);
</script>

