---
import { COASTLINE, PREF_BORDERS, LAND } from "./underlay";

export interface GeoPoint {
  lat: number;
  lng: number;
}

export interface Station {
  id: string;
  name: string;
  lat: number;
  lng: number;
  major?: boolean;
  labelDx?: number;
  labelDy?: number;
  labelAnchor?: "start" | "end";
}

export interface Segment {
  id: string;
  from: string;
  to: string;
  day: 1 | 2 | 3;
  jr18: boolean;
  fareYen: number | null;
  fareNote?: string;
  title: string;
  via?: GeoPoint[];
}

